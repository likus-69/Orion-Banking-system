# ─── Default app settings for local development ─────────────────
APP_NAME=Orion Banking API

# Database — SQLite for zero-config dev, Postgres for prod.
# Local dev (SQLite, file created automatically):
DATABASE_URL=sqlite:///./orion_banking.db
# Production (Postgres via docker-compose):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/orion_banking

# ─── Security ─────────────────────────────────────────────────────
# REQUIRED: generate with `openssl rand -hex 32`
SECRET_KEY=please-replace-with-a-strong-random-32-char-or-longer-string

# JWT config
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PIN policy
PIN_MIN_LENGTH=4
PIN_MAX_LENGTH=6

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=60

# ─── App environment ──────────────────────────────────────────────
# dev | staging | prod
ENV=dev
DEBUG=false
LOG_LEVEL=INFO
