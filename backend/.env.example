# ─── Default app settings for local development ─────────────────
APP_NAME=Orion Banking API

# Database — SQLite for zero-config dev, Postgres for prod.
# Local dev (SQLite, file created automatically):
DATABASE_URL=sqlite:///./orion_banking.db
# Production (Postgres via docker-compose):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/orion_banking

# ─── Security ─────────────────────────────────────────────────────
# REQUIRED: generate with `openssl rand -hex 32`
SECRET_KEY=please-replace-with-a-strong-random-32-char-or-longer-string

# JWT config
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PIN policy
PIN_MIN_LENGTH=4
PIN_MAX_LENGTH=6

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=60

# ─── App environment ──────────────────────────────────────────────
# dev | staging | prod
ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# ─── Email / SMTP ──────────────────────────────────────────────────
# Backend: "console" (prints to stdout, dev default), "memory" (tests only),
# or "smtp" (real SMTP server — required for prod).
EMAIL_BACKEND=console

# Sender identity shown in the From: header
EMAIL_FROM_ADDRESS=no-reply@orionbank.com
EMAIL_FROM_NAME=Orion Banking

# SMTP server config (only used when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
# For Gmail, use an App Password (not your account password):
SMTP_USERNAME=
SMTP_PASSWORD=

# If true, email delivery failures are logged but DON'T break the request.
# Set to false only if you want strict delivery guarantees.
EMAIL_SILENT_FAILURE=true

# ─── Transaction limits + fees ─────────────────────────────────────
# Per-transaction caps (prevents instant "trillionaire" bug)
MAX_DEPOSIT_PER_TRANSACTION=10000.00
MAX_WITHDRAWAL_PER_TRANSACTION=10000.00
MAX_TRANSFER_PER_TRANSACTION=10000.00
# Daily cumulative caps (anti-money-laundering)
MAX_DAILY_DEPOSIT=50000.00
MAX_DAILY_WITHDRAWAL=50000.00
MAX_DAILY_TRANSFER=50000.00
# Require KYC verification before allowing deposits
REQUIRE_KYC_FOR_DEPOSIT=true
# Transaction fee as a percentage (0.5% = 0.005) — applied on
# withdrawals and outgoing transfers. Deposits are free.
TRANSACTION_FEE_PERCENT=0.005
# Minimum balance to maintain after withdrawal/transfer
MINIMUM_BALANCE=0.00

# ─── Mobile money integration (MTN MoMo / Airtel Money) ──────────
# Provider: "stub" (mock for dev), "mtn_momo", "airtel_money"
MOBILE_MONEY_PROVIDER=stub

# MTN MoMo API credentials — get from https://momodeveloper.mtn.com
# Step 1: Subscribe to "Collection" API → get Primary + Secondary Key
# Step 2: POST /api/deposit/mtn/provision-api-user → get API User ID (UUID v4)
# Step 3: POST /api/deposit/mtn/create-api-key → get API Key
MTN_MOMO_PRIMARY_KEY=
MTN_MOMO_SECONDARY_KEY=
MTN_MOMO_API_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_HOST=localhost:8000
MTN_MOMO_ENVIRONMENT=sandbox

# Airtel Money API credentials — get from https://developers.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=sandbox
