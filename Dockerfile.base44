# Base44 sandbox image for Orion Banking.
#
# Only the dependency manifest is baked here — application source is bind-mounted
# by docker-compose.base44.yml so edits are picked up by the uvicorn reloader.
# Rebuild (`docker compose -f docker-compose.base44.yml build`) when
# backend/requirements.txt changes.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/backend

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
