// JavaScript Database & Bridge to Python Orion Banking Backend

class OrionBankSystem {
    constructor(apiBaseUrl = "http://127.0.0.1:5000/api") {
      this.baseUrl = apiBaseUrl;
    }
  
    // 1. Sign In: Sends (Account Number, Username) to Python
    async signIn(accountNumber, username) {
      try {
        const response = await fetch(`${this.baseUrl}/signin`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            account_number: accountNumber,
            username: username
          })
        });
  
        const data = await response.json();
        
        if (response.ok) {
          // Cache logged-in session locally in JS browser storage
          localStorage.setItem("activeUser", JSON.stringify(data.user));
          console.log("Success:", data.message);
        } else {
          console.error("Authentication Error:", data.message);
        }
  
        return data;
      } catch (err) {
        console.error("Network error connecting to Python server:", err);
      }
    }
  
    // 2. Sign Up: Registers new account in Python dictionary
    async signUp(username) {
      try {
        const response = await fetch(`${this.baseUrl}/signup`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username: username })
        });
  
        const data = await response.json();
        if (response.ok) {
          console.log("Registered:", data.message);
          console.log(`Assigned Account Number: ${data.user.account_number}`);
        }
        return data;
      } catch (err) {
        console.error("Network error connecting to Python server:", err);
      }
    }
  }